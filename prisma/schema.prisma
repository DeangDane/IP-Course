datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Hotel {
  id      Int       @id @default(autoincrement())
  name    String
  address String
  phone   String
  bookings Booking[]
}

model Booking {
  id           Int      @id @default(autoincrement())
  startDate    DateTime
  endDate      DateTime
  isCheckedIn  Boolean  @default(false)
  price        Float
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  hotelId      Int
}
